# Copy to .env and fill. NEVER commit .env.
#
# Local dev (docker-compose) uses the defaults below as-is. For a deployed
# environment (Render/Vercel/Atlas — see render.yaml + frontend/vercel.json),
# set these as real env vars on the host instead of a committed file:
#   MONGO_URI       -> MongoDB Atlas connection string
#   CORS_ORIGINS    -> your deployed frontend origin(s), comma-separated
#   JWT_SECRET      -> a long random value, NOT the dev default below
#   VITE_API_BASE_URL -> your deployed backend URL (set at Vercel build time)

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=io

# --- App ---
ENVIRONMENT=development
API_PORT=8000

# --- Auth ---
# Dev-only insecure default (see backend/app/config.py). MUST be overridden
# with a random secret in any deployed environment.
JWT_SECRET=dev-insecure-change-me

# --- CORS ---
# "*" is fine for local dev; a deployed backend should list explicit origins.
CORS_ORIGINS=*

# --- Integrations (added per phase) ---
# OpenProject (Phase 2). Rotate this token — it was shared in chat.
OPENPROJECT_BASE_URL=https://op.flynava.ai
OPENPROJECT_API_KEY=CHANGE_ME

# --- AI (Phase 5) — pluggable, first configured key wins (OpenAI > Anthropic) ---
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
